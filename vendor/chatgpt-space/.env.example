# Required API protection secret. Set this in Hugging Face Space Secrets.
API_SECRET_KEY=replace-with-a-long-random-secret

# Required ChatGPT browser session export in Netscape cookie format.
# Store the real value only as a Hugging Face Secret.
CHATGPT_COOKIES_NETSCAPE=

# Runtime configuration
PORT=7860
CHATGPT_HEADLESS=true
CHATGPT_READY_TIMEOUT=180
CHATGPT_REQUEST_TIMEOUT=210
MAX_PROMPT_CHARS=50000
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=INFO

# Comma-separated browser origins. Keep empty if no browser frontend is used.
ALLOWED_ORIGINS=
